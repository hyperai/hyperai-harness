diff --git a/lib/types/hyperaiOpenbayes.js b/lib/types/hyperaiOpenbayes.js
new file mode 100644
index 0000000..b5eaf81
--- /dev/null
+++ b/lib/types/hyperaiOpenbayes.js
@@ -0,0 +1,432 @@
+/**
+ * `/openbayes` command bridge and the startup sign-in gate for the TUI.
+ *
+ * Runs the skill's own `scripts/run_graphql.sh` locally: the authorize URL, the
+ * one-time code and the token never go through the model, the chat transcript
+ * or the session log. The gate blocks the chat with a managed dialog until a
+ * session exists; a valid session enters directly, and a session close to
+ * expiry only produces one startup notice.
+ *
+ * The skill is installed by the profile installer into `~/.agents/skills/`; it
+ * is never modified here. `hyperaiOpenbayesCore.js` holds the formatting,
+ * expiry math and validation so it can be tested without React or a terminal.
+ */
+import React from 'react'
+import { spawn } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { homedir, hostname } from 'node:os'
+import { join } from 'node:path'
+import { getLang } from './i18n.js'
+import {
+  VENDORS, classifyFailure, classifySession, errorText, expiredDuringUseText, expiringNoticeText, firstDiagnostic,
+  gateText, loginGateSkipped, loginPromptText, loginSuccessText, logoutConfirmText, logoutDoneText,
+  missingSkillText, normalizeCode, onlineNoticeText, parseAuthorize, parseIdentity, parseLoginSuccess, redact,
+  skippedGateText, statusText, usageText,
+} from './hyperaiOpenbayesCore.js'
+
+const LOGIN_TIMEOUT_MS = 60_000
+const CODE_TIMEOUT_MS = 120_000
+const IDENTITY_TIMEOUT_MS = 30_000
+const WHOAMI_TIMEOUT_MS = 15_000
+const LOGOUT_TIMEOUT_MS = 30_000
+const DIALOG_TIMEOUT_MS = 300_000
+/** Long enough to wait for a person; JS timers overflow above 2^31-1 ms. */
+const GATE_DIALOG_TIMEOUT_MS = 24 * 60 * 60 * 1000
+const EXPIRY_POLL_MS = 10_000
+
+/** Current UI language (`zh` / `en`). Resolved at call time, so `/lang` works. */
+function lang() {
+  return getLang() === 'zh' ? 'zh' : 'en'
+}
+
+/** Dialog title for a vendor and a phase. */
+function heading(vendor, suffix) {
+  return `${vendor.label}${suffix === undefined ? '' : suffix}`
+}
+
+/**
+ * Resolve the skill location for a vendor. `HOME` is read at call time so a
+ * test can point it at a temporary directory.
+ * @param {NodeJS.ProcessEnv} env
+ * @param {{ name: string, label: string, consoleTokens: string }} vendor
+ */
+export function resolveOpenbayesContext(env = process.env, vendor = VENDORS.openbayes) {
+  const home = env.HOME || homedir()
+  const dir = join(home, '.agents', 'skills', `${vendor.name}-user`)
+  const script = join(dir, 'scripts', 'run_graphql.sh')
+  return { vendor, home, dir, script, available: existsSync(script) }
+}
+
+/** Run the skill CLI with a bounded lifetime; never throws. */
+function run(context, args, timeoutMs) {
+  return new Promise(resolve => {
+    let stdout = ''
+    let stderr = ''
+    let timedOut = false
+    let settled = false
+    const settle = value => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      resolve(value)
+    }
+    const child = spawn('bash', [context.script, ...args], { stdio: ['ignore', 'pipe', 'pipe'] })
+    const timer = setTimeout(() => {
+      timedOut = true
+      child.kill('SIGKILL')
+    }, timeoutMs)
+    child.stdout.on('data', chunk => { stdout += String(chunk) })
+    child.stderr.on('data', chunk => { stderr += String(chunk) })
+    child.on('error', error => settle({ code: -1, stdout, stderr: `${stderr}\n${error.message}`, timedOut }))
+    child.on('close', code => settle({ code, stdout, stderr, timedOut }))
+  })
+}
+
+/** Read the offline identity of the current vendor. */
+export async function readIdentityOnce(vendor = VENDORS.openbayes) {
+  const context = resolveOpenbayesContext(process.env, vendor)
+  if (!context.available) return { error: { code: -1, stdout: '', stderr: 'skill missing' }, missing: true }
+  const result = await run(context, ['--vendor', vendor.name, '--identity', '--pretty'], IDENTITY_TIMEOUT_MS)
+  if (result.code !== 0) return { error: result }
+  try {
+    return { identity: parseIdentity(result.stdout) }
+  } catch {
+    return { error: result }
+  }
+}
+
+/** One lightweight online identity check (`whoami`); never blocks the first frame. */
+export async function verifyOnline(vendor = VENDORS.openbayes) {
+  const context = resolveOpenbayesContext(process.env, vendor)
+  if (!context.available) return { kind: 'missing' }
+  const whoami = join(context.dir, 'references', 'graphql-operations', 'common', 'whoami.graphql')
+  const result = await run(context, ['--vendor', vendor.name, '--query-file', whoami], WHOAMI_TIMEOUT_MS)
+  if (result.code === 0) return { ok: true }
+  return { kind: classifyFailure(result) }
+}
+
+/**
+ * The shared sign-in flow used by `/openbayes login` and the startup gate.
+ * Returns `{ ok: true }` only after the exchange and identity read succeed.
+ * @param {{ dialogs: any, vendor?: any, notify?: (message: string) => void }} options
+ */
+export async function runLoginFlow({ dialogs, vendor = VENDORS.openbayes, notify = () => {} }) {
+  const showInfo = async (title, message) => {
+    try {
+      await dialogs.ask({
+        kind: 'confirm',
+        title,
+        message,
+        confirmLabel: lang() === 'zh' ? '确定' : 'OK',
+        cancelLabel: lang() === 'zh' ? '关闭' : 'Close',
+      }, undefined, DIALOG_TIMEOUT_MS)
+    } catch {
+      notify(message)
+    }
+  }
+  const context = resolveOpenbayesContext(process.env, vendor)
+  if (!context.available) {
+    await showInfo(heading(vendor), missingSkillText(vendor, lang()))
+    return { ok: false, missing: true }
+  }
+  const started = await run(context, ['--login', '--vendor', vendor.name], LOGIN_TIMEOUT_MS)
+  if (started.code !== 0) {
+    await showInfo(heading(vendor, lang() === 'zh' ? ' 登录' : ' sign-in'),
+      errorText(classifyFailure(started), firstDiagnostic(started), lang()))
+    return { ok: false, kind: classifyFailure(started) }
+  }
+  const prompt = parseAuthorize(started.stdout)
+  if (prompt.url === undefined) {
+    await showInfo(heading(vendor, lang() === 'zh' ? ' 登录' : ' sign-in'), errorText('unknown', firstDiagnostic(started), lang()))
+    return { ok: false, kind: 'unknown' }
+  }
+  const proceed = await dialogs.ask({
+    kind: 'confirm',
+    title: heading(vendor, lang() === 'zh' ? ' 登录' : ' sign-in'),
+    message: loginPromptText(prompt, lang()),
+    confirmLabel: lang() === 'zh' ? '已确认，输入一次性码' : 'Confirmed, enter code',
+    cancelLabel: lang() === 'zh' ? '取消' : 'Cancel',
+  }, undefined, DIALOG_TIMEOUT_MS)
+  if (proceed !== true) return { ok: false, cancelled: true }
+
+  const answer = await dialogs.ask({
+    kind: 'input',
+    title: lang() === 'zh' ? '输入一次性码（5 分钟内有效）' : 'Enter the one-time code (valid for 5 minutes)',
+    placeholder: lang() === 'zh' ? '粘贴一次性码' : 'Paste the one-time code',
+    mask: true,
+    initial: '',
+  }, undefined, DIALOG_TIMEOUT_MS)
+  const checked = normalizeCode(answer)
+  if (!checked.ok) {
+    if (checked.reason !== 'cancelled') {
+      await showInfo(heading(vendor, lang() === 'zh' ? ' 登录' : ' sign-in'),
+        errorText('code', redact(firstDiagnostic(started), String(answer ?? '')), lang()))
+    }
+    return { ok: false, kind: checked.reason === 'cancelled' ? 'cancelled' : 'code' }
+  }
+
+  const exchanged = await run(context, ['--login', '--vendor', vendor.name, '--code', checked.code], CODE_TIMEOUT_MS)
+  const detail = redact(firstDiagnostic(exchanged), checked.code)
+  if (exchanged.code !== 0) {
+    await showInfo(heading(vendor, lang() === 'zh' ? ' 登录' : ' sign-in'), errorText(classifyFailure(exchanged), detail, lang()))
+    return { ok: false, kind: classifyFailure(exchanged) }
+  }
+  const { identity, error } = await readIdentityOnce(vendor)
+  if (identity === undefined) {
+    const success = parseLoginSuccess(exchanged.stdout)
+    if (success.expiresAt !== undefined) {
+      await showInfo(heading(vendor, lang() === 'zh' ? ' 登录' : ' sign-in'), loginSuccessText({ expiresAt: success.expiresAt }, lang()))
+      return { ok: true, identity: { expiresAt: success.expiresAt, expired: false } }
+    }
+    await showInfo(heading(vendor, lang() === 'zh' ? ' 登录' : ' sign-in'),
+      errorText(classifyFailure(error), redact(firstDiagnostic(error), checked.code), lang()))
+    return { ok: false, kind: classifyFailure(error) }
+  }
+  await showInfo(heading(vendor, lang() === 'zh' ? ' 登录' : ' sign-in'), loginSuccessText(identity, lang()))
+  return { ok: true, identity }
+}
+
+/**
+ * Startup sign-in gate. Mounted once by the Chat screen; it owns the blocking
+ * dialog loop and the one-shot notices.
+ * @param {{ channel: any, dialogs: any, vendor?: any }} options
+ */
+export function useOpenbayesGate({ channel, dialogs, vendor = VENDORS.openbayes }) {
+  const skipped = loginGateSkipped(process.env)
+  const [notice, setNotice] = React.useState(skipped ? skippedGateText(lang()) : undefined)
+  const [blocked, setBlocked] = React.useState(false)
+  const gateRef = React.useRef(false)
+  const expiringNotified = React.useRef(false)
+  const onlineNotified = React.useRef(false)
+  const expiredNotified = React.useRef(false)
+  const checking = React.useRef(false)
+
+  const notify = React.useCallback(message => {
+    try { channel.notify(message, { color: 'warning', timeoutMs: 12_000 }) } catch { /* best-effort */ }
+  }, [channel])
+
+  /** Block the chat until sign-in succeeds; the dialog reopens on cancel/Esc. */
+  const blockUntilSignedIn = React.useCallback(async state => {
+    if (gateRef.current) return
+    gateRef.current = true
+    setBlocked(true)
+    try {
+      while (gateRef.current) {
+        const text = gateText(state, vendor, lang())
+        let proceed
+        try {
+          proceed = await dialogs.ask({
+            kind: 'confirm',
+            title: text.title,
+            message: text.message,
+            confirmLabel: lang() === 'zh' ? '登录 OpenBayes' : 'Sign in to OpenBayes',
+            cancelLabel: lang() === 'zh' ? '稍后（仍不能使用）' : 'Later (still blocked)',
+          }, undefined, GATE_DIALOG_TIMEOUT_MS)
+        } catch {
+          continue
+        }
+        if (proceed !== true) continue
+        const result = await runLoginFlow({ dialogs, vendor, notify })
+        if (!result.ok) continue
+        const checked = await readIdentityOnce(vendor)
+        const next = checked.identity === undefined ? { state: 'valid' } : classifySession(checked.identity)
+        if (next.state === 'valid' || next.state === 'expiring') {
+          gateRef.current = false
+          setBlocked(false)
+          setNotice(undefined)
+          void verifyOnline(vendor).then(online => {
+            const message = online.kind === undefined ? undefined : onlineNoticeText(online.kind, lang())
+            if (message !== undefined && !onlineNotified.current) {
+              onlineNotified.current = true
+              notify(message)
+            }
+          })
+          return
+        }
+        state = next.state === 'expired' ? { state: 'expired', expiresAt: next.expiresAt } : { state: 'rejected' }
+      }
+    } finally {
+      gateRef.current = false
+    }
+  }, [dialogs, notify, vendor])
+
+  /** Skill missing: explain, offer manual install and a re-check loop. */
+  const blockMissingSkill = React.useCallback(async () => {
+    gateRef.current = true
+    setBlocked(true)
+    try {
+      while (gateRef.current) {
+        let proceed
+        try {
+          proceed = await dialogs.ask({
+            kind: 'confirm',
+            title: lang() === 'zh' ? '登录 OpenBayes（必需）' : 'Sign in to OpenBayes (required)',
+            message: `${missingSkillText(vendor, lang())}\n\n${lang() === 'zh' ? '手动安装后选择「重新检测」；按 Ctrl+D 退出程序。' : 'After installing, choose "Check again"; press Ctrl+D to quit.'}`,
+            confirmLabel: lang() === 'zh' ? '重新检测' : 'Check again',
+            cancelLabel: lang() === 'zh' ? '仍不可用' : 'Still blocked',
+          }, undefined, GATE_DIALOG_TIMEOUT_MS)
+        } catch {
+          continue
+        }
+        if (proceed !== true) continue
+        const context = resolveOpenbayesContext(process.env, vendor)
+        if (!context.available) continue
+        gateRef.current = false
+        return evaluate({ online: true })
+      }
+    } finally {
+      gateRef.current = false
+    }
+  }, [dialogs, vendor])
+
+  const evaluate = React.useCallback(async ({ online = true, block = true } = {}) => {
+    if (skipped || checking.current) return
+    checking.current = true
+    try {
+      const context = resolveOpenbayesContext(process.env, vendor)
+      if (!context.available) {
+        if (block) await blockMissingSkill()
+        return
+      }
+      const { identity, error } = await readIdentityOnce(vendor)
+      const kind = identity === undefined ? classifyFailure(error) : undefined
+      if (identity === undefined && kind !== 'not-logged-in' && kind !== 'rejected') {
+        // An unreadable identity is treated as "not signed in" only when the
+        // skill itself said so; otherwise keep the gate closed with a reason.
+        if (block) await blockUntilSignedIn({ state: 'rejected' })
+        return
+      }
+      if (identity === undefined) {
+        if (block) await blockUntilSignedIn({ state: kind === 'rejected' ? 'rejected' : 'missing' })
+        return
+      }
+      const session = classifySession(identity)
+      if (session.state === 'expired') {
+        if (block) return blockUntilSignedIn({ state: 'expired', expiresAt: session.expiresAt })
+        if (!expiredNotified.current) {
+          expiredNotified.current = true
+          notify(expiredDuringUseText(lang()))
+        }
+        return
+      }
+      if (session.state === 'expiring' && !expiringNotified.current) {
+        expiringNotified.current = true
+        notify(expiringNoticeText(session.days, lang()))
+      }
+      if (online) {
+        void verifyOnline(vendor).then(result => {
+          if (result.ok === true) return
+          const message = onlineNoticeText(result.kind, lang())
+          if (message !== undefined && !onlineNotified.current) {
+            onlineNotified.current = true
+            notify(message)
+          }
+        })
+      }
+    } finally {
+      checking.current = false
+    }
+  }, [blockMissingSkill, blockUntilSignedIn, notify, skipped, vendor])
+
+  React.useEffect(() => {
+    if (skipped) return undefined
+    const timer = setTimeout(() => { void evaluate({ online: true }) }, 0)
+    const poll = setInterval(() => { void evaluate({ online: false, block: false }) }, EXPIRY_POLL_MS)
+    return () => { clearTimeout(timer); clearInterval(poll) }
+  }, [evaluate, skipped])
+
+  const requireLogin = React.useCallback(async () => {
+    if (skipped) return
+    // A scheduled expiry poll may be in flight; wait for it so the logout
+    // check is never skipped by the `checking` guard.
+    const deadline = Date.now() + 2_000
+    while (checking.current && Date.now() < deadline) {
+      await new Promise(resolve => setTimeout(resolve, 25))
+    }
+    await evaluate({ online: true, block: true })
+  }, [evaluate, skipped])
+
+  return { notice, blocked, requireLogin, skipped }
+}
+
+/**
+ * `/openbayes` command bridge: login / status / logout and the local help copy.
+ * @param {{ channel: any, dialogs: any, vendor?: any, onLoggedOut?: () => void }} options
+ */
+export function useOpenbayes({ channel, dialogs, vendor = VENDORS.openbayes, onLoggedOut = () => {} }) {
+  const notify = React.useCallback(message => {
+    try { channel.notify(message, { color: 'warning', timeoutMs: 10_000 }) } catch { /* best-effort */ }
+  }, [channel])
+
+  const showInfo = React.useCallback(async (title, message) => {
+    try {
+      await dialogs.ask({
+        kind: 'confirm',
+        title,
+        message,
+        confirmLabel: lang() === 'zh' ? '确定' : 'OK',
+        cancelLabel: lang() === 'zh' ? '关闭' : 'Close',
+      }, undefined, DIALOG_TIMEOUT_MS)
+    } catch {
+      notify(message)
+    }
+  }, [dialogs, notify])
+
+  const login = React.useCallback(async () => {
+    await runLoginFlow({ dialogs, vendor, notify })
+  }, [dialogs, notify, vendor])
+
+  const status = React.useCallback(async () => {
+    const context = resolveOpenbayesContext(process.env, vendor)
+    if (!context.available) {
+      await showInfo(heading(vendor), missingSkillText(vendor, lang()))
+      return
+    }
+    const { identity, error } = await readIdentityOnce(vendor)
+    if (identity !== undefined) {
+      const session = classifySession(identity)
+      const base = statusText(identity, lang())
+      const text = session.state === 'expiring'
+        ? `${base}\n${lang() === 'zh' ? '即将到期' : 'expiring soon'}`
+        : base
+      await showInfo(heading(vendor, lang() === 'zh' ? ' 状态' : ' status'), text)
+      return
+    }
+    const kind = classifyFailure(error)
+    if (kind === 'not-logged-in') {
+      await showInfo(heading(vendor, lang() === 'zh' ? ' 状态' : ' status'), statusText(undefined, lang()))
+      return
+    }
+    await showInfo(heading(vendor, lang() === 'zh' ? ' 状态' : ' status'), errorText(kind, firstDiagnostic(error), lang()))
+  }, [showInfo, vendor])
+
+  const logout = React.useCallback(async () => {
+    const context = resolveOpenbayesContext(process.env, vendor)
+    if (!context.available) {
+      await showInfo(heading(vendor), missingSkillText(vendor, lang()))
+      return
+    }
+    const confirmed = await dialogs.ask({
+      kind: 'confirm',
+      title: lang() === 'zh' ? '退出 OpenBayes 登录？' : 'Sign out of OpenBayes?',
+      message: logoutConfirmText(lang()),
+      confirmLabel: lang() === 'zh' ? '退出登录' : 'Sign out',
+      cancelLabel: lang() === 'zh' ? '取消' : 'Cancel',
+    }, undefined, DIALOG_TIMEOUT_MS)
+    if (confirmed !== true) return
+    const result = await run(context, ['--logout', '--vendor', vendor.name], LOGOUT_TIMEOUT_MS)
+    if (result.code !== 0) {
+      await showInfo(heading(vendor, lang() === 'zh' ? ' 退出' : ' sign-out'),
+        errorText(classifyFailure(result), firstDiagnostic(result), lang()))
+      return
+    }
+    notify(logoutDoneText(vendor, hostname(), lang()))
+    onLoggedOut()
+  }, [dialogs, notify, onLoggedOut, showInfo, vendor])
+
+  const help = React.useCallback(async () => {
+    await showInfo(heading(vendor), usageText(lang()))
+  }, [showInfo, vendor])
+
+  return { login, status, logout, help }
+}
diff --git a/lib/types/hyperaiOpenbayesCore.js b/lib/types/hyperaiOpenbayesCore.js
new file mode 100644
index 0000000..7587b68
--- /dev/null
+++ b/lib/types/hyperaiOpenbayesCore.js
@@ -0,0 +1,311 @@
+/**
+ * Pure formatting/validation for the OpenBayes TUI bridge.
+ *
+ * Kept dependency-free (no React, no child_process) so the login prompt, the
+ * identity parsing, the error copy and the code hygiene can be unit-tested
+ * offline. `hyperaiOpenbayes.js` is the thin React/spawn layer on top.
+ *
+ * The vendor is a parameter, not a constant in the logic: adding `/hyperai`
+ * later should only register another command with a different descriptor.
+ */
+
+/** Console pages used in the copy; a future vendor only supplies its own. */
+export const VENDORS = Object.freeze({
+  openbayes: Object.freeze({
+    name: 'openbayes',
+    label: 'OpenBayes',
+    consoleTokens: 'https://openbayes.com/console/settings/account/personalAccessToken',
+  }),
+})
+
+/** Longest one-time code we accept; the real ones are far shorter. */
+const MAX_CODE_LENGTH = 512
+
+/** Translation pair helper; `lang` is `zh` or anything else for English. */
+function pick(lang, zh, en) {
+  return lang === 'zh' ? zh : en
+}
+
+/**
+ * Reject empty/oversized/control-character codes before they become argv.
+ * @param {string | undefined} raw Answer from the dialog.
+ * @returns {{ ok: boolean, code?: string, reason?: string }}
+ */
+export function normalizeCode(raw) {
+  if (typeof raw !== 'string') return { ok: false, reason: 'cancelled' }
+  const code = raw.trim()
+  if (code === '') return { ok: false, reason: 'empty' }
+  if (code.length > MAX_CODE_LENGTH) return { ok: false, reason: 'too-long' }
+  if (/[\u0000-\u001f\u007f]/u.test(code)) return { ok: false, reason: 'control' }
+  return { ok: true, code }
+}
+
+/** The character the TUI shows for each masked code cell. */
+export const MASK_CHAR = '•'
+
+/**
+ * What the masked input renders for a value: one bullet per code point, so the
+ * cursor offset and visible width stay aligned with the raw text.
+ * @param {string} value
+ * @returns {string}
+ */
+export function maskedInput(value) {
+  return MASK_CHAR.repeat([...String(value)].length)
+}
+
+/** Remove a secret from any text that might be shown or logged. */
+export function redact(text, secret) {
+  if (typeof text !== 'string' || typeof secret !== 'string' || secret === '') return text
+  return text.split(secret).join('***')
+}
+
+/**
+ * Parse the first stage of `--login`: the authorize URL, endpoint and device.
+ * @param {string} stdout
+ */
+export function parseAuthorize(stdout) {
+  const text = typeof stdout === 'string' ? stdout : ''
+  const url = text.match(/https?:\/\/\S+?authorize\S*/u)?.[0] ?? text.match(/https?:\/\/\S+/u)?.[0]
+  const device = text.match(/^Device:\s*(.+)$/mu)?.[1]?.trim()
+  const endpoint = text.match(/^Endpoint:\s*(.+)$/mu)?.[1]?.trim()
+  return { url, device, endpoint }
+}
+
+/**
+ * Parse `--identity` (JSON) into the small view the dialogs need.
+ * @param {string} stdout
+ */
+export function parseIdentity(stdout) {
+  const value = JSON.parse(stdout)
+  if (value === null || typeof value !== 'object') throw new Error('identity returned no object')
+  const username = typeof value.sub === 'string' && value.sub !== '' ? value.sub : undefined
+  return {
+    vendor: typeof value.vendor === 'string' ? value.vendor : undefined,
+    username,
+    expiresAt: typeof value.expires_at === 'string' ? value.expires_at : undefined,
+    expired: value.expired === true,
+    endpoint: typeof value.endpoint === 'string' ? value.endpoint : undefined,
+  }
+}
+
+/**
+ * Parse the second stage confirmation line
+ * (`Logged in as vendor "openbayes" (token name: …, expires: …).`).
+ * @param {string} stdout
+ */
+export function parseLoginSuccess(stdout) {
+  const text = typeof stdout === 'string' ? stdout : ''
+  const tokenName = text.match(/token name:\s*([^,)]+)/u)?.[1]?.trim()
+  const expiresAt = text.match(/expires:\s*([^)]+)\)/u)?.[1]?.trim()
+  return { tokenName, expiresAt }
+}
+
+/**
+ * Classify a failed command into the error kinds the copy distinguishes.
+ * @param {{ code?: number, stdout?: string, stderr?: string, timedOut?: boolean }} result
+ */
+export function classifyFailure(result = {}) {
+  if (result.timedOut === true) return 'timeout'
+  const text = `${result.stdout ?? ''}\n${result.stderr ?? ''}`
+  if (/MISSING_TOKEN/u.test(text)) return 'not-logged-in'
+  if (/\b401\b|Unauthorized|AUTH_|invalid[_ ]token|token[_ ]invalid|认证失败|登录已失效|已被吊销/iu.test(text)) return 'rejected'
+  if (/LOGIN_EXCHANGE_FAILED|LOGIN_PENDING_EXPIRED|NO_PENDING_LOGIN|授权码无效|已过期|invalid|expired/iu.test(text)) return 'code'
+  if (/'node' not found|Node\.js 18\+|node: command not found/iu.test(text)) return 'node'
+  if (/ENOTFOUND|ECONNREFUSED|ECONNRESET|ETIMEDOUT|EAI_AGAIN|fetch failed|network|timeout|timed out|网络/iu.test(text)) return 'network'
+  return 'unknown'
+}
+
+/** First non-empty diagnostic line, for the generic error copy. */
+export function firstDiagnostic(result = {}) {
+  const text = `${result.stderr ?? ''}\n${result.stdout ?? ''}`
+  const line = text.split('\n').map(item => item.trim()).find(item => item !== '')
+  return line ?? ''
+}
+
+/** `status` copy: logged in with name/expiry, or the not-logged-in hint. */
+export function statusText(identity, lang = 'zh') {
+  if (identity === undefined) {
+    return pick(lang,
+      '未登录 OpenBayes。执行 /openbayes login 登录。',
+      'Not signed in to OpenBayes. Run /openbayes login.')
+  }
+  const name = identity.username ?? '（未知用户）'
+  const expiry = identity.expiresAt ?? '（未知）'
+  const state = identity.expired
+    ? pick(lang, '已过期，请重新登录', 'expired; sign in again')
+    : pick(lang, '有效', 'valid')
+  return pick(lang,
+    `已登录 OpenBayes\n用户名：${name}\n到期：${expiry}\n状态：${state}`,
+    `Signed in to OpenBayes\nUser: ${name}\nExpires: ${expiry}\nState: ${state}`)
+}
+
+/** Login dialog copy; the URL is shown before the code is requested. */
+export function loginPromptText({ url, device }, lang = 'zh') {
+  return pick(lang,
+    `用已经登录 OpenBayes 的浏览器打开下面的链接，确认后把一次性码粘贴到下一步的输入框：\n\n${url}\n\n` +
+      `令牌有效期按需选择（日常建议 7 天或 30 天）。${device === undefined ? '' : `\n设备名：${device}`}`,
+    `Open this URL in a browser already signed in to OpenBayes, confirm, then paste the one-time code in the next dialog:\n\n${url}\n\n` +
+      `Pick the token lifetime you need (7 or 30 days for daily use).${device === undefined ? '' : `\nDevice: ${device}`}`)
+}
+
+/** Success copy after the code exchange. */
+export function loginSuccessText(identity, lang = 'zh') {
+  const name = identity?.username ?? '（未知用户）'
+  const expiry = identity?.expiresAt ?? '（未知）'
+  return pick(lang,
+    `登录成功。用户名：${name}\n令牌到期：${expiry}`,
+    `Signed in. User: ${name}\nToken expires: ${expiry}`)
+}
+
+/** Logout confirmation, then the message that explains server-side revocation. */
+export function logoutConfirmText(lang = 'zh') {
+  return pick(lang,
+    '退出后这台机器上的登录会被删除。服务端的令牌仍然有效，需要到控制台手动吊销。',
+    'Signing out removes the local session only. The server-side token stays valid until you revoke it in the console.')
+}
+
+export function logoutDoneText(vendor, device, lang = 'zh') {
+  const suffix = device === undefined ? '' : ` · ${device}`
+  return pick(lang,
+    `本地登录已删除。服务端的令牌仍然有效，如需彻底撤销，请到 ${vendor.consoleTokens} 吊销名为 'CLI${suffix}' 的令牌。`,
+    `Local session deleted. The server-side token is still valid; revoke 'CLI${suffix}' at ${vendor.consoleTokens}).`)
+}
+
+/** Missing-skill copy with the manual install command. */
+export function missingSkillText(vendor, lang = 'zh') {
+  return pick(lang,
+    `没有找到 ${vendor.name}-user。请重新运行安装包，或手动安装：\n\nnpx skills add https://openbayes.com/skills/${vendor.name}-user`,
+    `${vendor.name}-user was not found. Re-run the installer, or install it manually:\n\nnpx skills add https://openbayes.com/skills/${vendor.name}-user`)
+}
+
+/** Error copy keyed by {@link classifyFailure}. */
+export function errorText(kind, detail, lang = 'zh') {
+  const tail = detail === undefined || detail === '' ? '' : `\n${detail}`
+  switch (kind) {
+    case 'not-logged-in':
+      return pick(lang,
+        '未登录 OpenBayes。执行 /openbayes login 登录。',
+        'Not signed in to OpenBayes. Run /openbayes login.')
+    case 'code':
+      return pick(lang,
+        '一次性码无效或已过期。请重新执行 /openbayes login。',
+        'The one-time code is invalid or expired. Run /openbayes login again.')
+    case 'node':
+      return pick(lang,
+        '找不到 Node.js（openbayes-user 需要 18 及以上）。请先安装 Node.js，再重新登录。',
+        'Node.js 18+ was not found (required by openbayes-user). Install it and try again.')
+    case 'network':
+      return pick(lang,
+        '网络请求失败，请检查网络后重试。',
+        'The network request failed. Check connectivity and try again.')
+    case 'timeout':
+      return pick(lang,
+        '操作超时。请检查网络后重试。',
+        'The operation timed out. Check connectivity and try again.')
+    default:
+      return pick(lang, `OpenBayes 操作失败。${tail}`, `OpenBayes failed.${tail}`)
+  }
+}
+
+/** `/openbayes` usage when no (or an unknown) subcommand is given. */
+export function usageText(lang = 'zh') {
+  return pick(lang,
+    '用法：\n/openbayes login   登录 OpenBayes\n/openbayes status  查看登录状态\n/openbayes logout  退出登录（只删除本地 session）',
+    'Usage:\n/openbayes login   sign in\n/openbayes status  show sign-in status\n/openbayes logout  sign out (local session only)')
+}
+
+/** How close to expiry a session must be before the startup notice appears. */
+export const EXPIRY_NOTICE_MS = 3 * 24 * 60 * 60 * 1000
+
+/**
+ * Milliseconds from now until `expiresAt`, or undefined when unparseable.
+ * @param {string | undefined} expiresAt ISO timestamp from `--identity`.
+ * @param {number} now epoch milliseconds (tests pass a fixed clock).
+ */
+export function millisUntilExpiry(expiresAt, now = Date.now()) {
+  if (typeof expiresAt !== 'string') return undefined
+  const at = Date.parse(expiresAt)
+  if (Number.isNaN(at)) return undefined
+  return at - now
+}
+
+/** Whole days shown to a person; zero or negative stays 0. */
+export function daysUntilExpiry(expiresAt, now = Date.now()) {
+  const remaining = millisUntilExpiry(expiresAt, now)
+  if (remaining === undefined || remaining <= 0) return 0
+  return Math.ceil(remaining / 86_400_000)
+}
+
+/**
+ * Classify a session from the offline `--identity` view.
+ * @param {{ expired?: boolean, expiresAt?: string } | undefined} identity
+ * @param {number} now
+ * @returns {{ state: 'missing'|'expired'|'expiring'|'valid'|'unknown', days?: number, expiresAt?: string }}
+ */
+export function classifySession(identity, now = Date.now()) {
+  if (identity === undefined) return { state: 'missing' }
+  if (identity.expired === true) return { state: 'expired', expiresAt: identity.expiresAt }
+  const remaining = millisUntilExpiry(identity.expiresAt, now)
+  if (remaining === undefined) return { state: 'unknown', expiresAt: identity.expiresAt }
+  if (remaining <= 0) return { state: 'expired', expiresAt: identity.expiresAt, days: 0 }
+  if (remaining < EXPIRY_NOTICE_MS) {
+    return { state: 'expiring', days: daysUntilExpiry(identity.expiresAt, now), expiresAt: identity.expiresAt }
+  }
+  return { state: 'valid', days: daysUntilExpiry(identity.expiresAt, now), expiresAt: identity.expiresAt }
+}
+
+/** The startup gate is skipped only for the exact value `off`. */
+export function loginGateSkipped(env = process.env) {
+  return env.HYPERAI_LOGIN_GATE === 'off'
+}
+
+/** Persistent banner while the gate is skipped (test-only). */
+export function skippedGateText(lang = 'zh') {
+  return pick(lang, '测试模式：已跳过 OpenBayes 登录', 'Test mode: OpenBayes sign-in skipped')
+}
+
+/** Title + body of the blocking sign-in screen. */
+export function gateText(state, vendor, lang = 'zh') {
+  const expiryHint = state.expiresAt === undefined ? '' : `\n（到期时间：${state.expiresAt}）`
+  const body = pick(lang,
+    `HyperAI Harness 需要登录 OpenBayes 账号才能使用。\n\n` +
+      `1. 选择下面的「登录 OpenBayes」；\n2. 用已登录 OpenBayes 的浏览器打开显示的链接；\n3. 确认后把一次性码粘贴回输入框。\n\n` +
+      `按 Ctrl+D 退出程序。`,
+    `HyperAI Harness requires an OpenBayes account.\n\n` +
+      `1. Choose "Sign in to OpenBayes" below.\n2. Open the link in a browser signed in to OpenBayes.\n3. Paste the one-time code back here.\n\n` +
+      `Press Ctrl+D to quit.`)
+  let reason = ''
+  if (state.state === 'expired') {
+    reason = pick(lang, `OpenBayes 登录已过期，请重新登录。${expiryHint}`, `OpenBayes sign-in expired; sign in again.${expiryHint}`)
+  } else if (state.state === 'missing') {
+    reason = pick(lang, '这台电脑还没有登录过 OpenBayes。', 'This computer has not signed in to OpenBayes yet.')
+  } else if (state.state === 'rejected') {
+    reason = pick(lang, 'OpenBayes 登录已失效，请重新登录。', 'OpenBayes sign-in is no longer valid; sign in again.')
+  }
+  return { title: pick(lang, '登录 OpenBayes（必需）', 'Sign in to OpenBayes (required)'), message: reason === '' ? body : `${reason}\n\n${body}` }
+}
+
+/** One-time startup notice for a session that is about to expire. */
+export function expiringNoticeText(days, lang = 'zh') {
+  return pick(lang,
+    `OpenBayes 登录将在 ${days} 天后到期，输入 /openbayes login 续期。`,
+    `OpenBayes sign-in expires in ${days} day(s); run /openbayes login to renew.`)
+}
+
+/** One-time notices for online failures. */
+export function onlineNoticeText(kind, lang = 'zh') {
+  if (kind === 'network') {
+    return pick(lang, '暂时连不上 OpenBayes，相关功能可能用不了。', 'Cannot reach OpenBayes right now; related features may not work.')
+  }
+  if (kind === 'rejected') {
+    return pick(lang, 'OpenBayes 登录已失效，请输入 /openbayes login 重新登录。', 'OpenBayes sign-in is no longer valid; run /openbayes login.')
+  }
+  return undefined
+}
+
+/** Session expired while the app was running: one warning, no interruption. */
+export function expiredDuringUseText(lang = 'zh') {
+  return pick(lang,
+    'OpenBayes 登录已过期。现在可以输入 /openbayes login 续期；不续期的话，下次启动时会回到登录界面。',
+    'OpenBayes sign-in expired. Run /openbayes login to renew; otherwise the next launch will ask you to sign in.')
+}
