{
  "tty": {
    "stdin": true,
    "stdout": false
  },
  "env": {
    "TERM": "xterm-256color",
    "TERM_PROGRAM": "Orca",
    "TERM_PROGRAM_VERSION": "1.4.244",
    "COLORTERM": "truecolor"
  },
  "probes": {
    "da1": [
      1,
      2
    ],
    "xtversion": ">|xterm.js(6.0.0)",
    "background": [
      255,
      255,
      255
    ],
    "foreground": [
      46,
      52,
      52
    ]
  },
  "decision": {
    "multiplexer": "none",
    "protocol": "none",
    "imagesAvailable": false,
    "variant": "light",
    "lightBackground": true,
    "path": "ANSI sprite (light variant)",
    "fallbackReasons": [
      "no Kitty Graphics / Sixel response"
    ],
    "verification": "ANSI fallback is the first frame and requires no capability confirmation"
  }
}
